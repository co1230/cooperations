page{background:#f5f5f5;-webkit-box-sizing:border-box;box-sizing:border-box;color:#333;font-size:28rpx;line-height:1.5}.primary{color:#ff5000}.bg-primary{background:#ff5000;color:#fff}.page{-webkit-box-sizing:border-box;box-sizing:border-box;min-height:100vh;padding:20rpx}.header-title{font-size:20rpx;font-weight:700;margin-bottom:14rpx}.card{background:#fff;border-radius:12rpx;-webkit-box-shadow:0 1rpx 4rpx rgba(0,0,0,.04);box-shadow:0 1rpx 4rpx rgba(0,0,0,.04);margin-bottom:14rpx;padding:16rpx}.price{color:#ff5000;font-weight:700}.tag{background:#fff0e8;border-radius:6rpx;color:#ff5000;display:inline-block;font-size:12rpx;padding:2rpx 8rpx}.btn{background:#ff5000;border:none;border-radius:8rpx;color:#fff;font-size:14rpx;padding:8rpx 18rpx;text-align:center}.btn-secondary{background:#fff;border:1rpx solid #ddd;border-radius:8rpx;color:#333;font-size:14rpx;padding:8rpx 18rpx;text-align:center}.btn-danger{background:#fff;border:1rpx solid #ff4d4f;border-radius:8rpx;color:#ff4d4f;font-size:14rpx;padding:8rpx 18rpx}.btn[disabled]{opacity:.5}.empty{color:#999;padding:80rpx 0;text-align:center}.empty .icon{font-size:60rpx;margin-bottom:12rpx}.search-input{background:#fff;border:none;border-radius:20rpx;font-size:14rpx;padding:8rpx 16rpx}.grid-2{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-wrap:wrap;-ms-flex-wrap:wrap;flex-wrap:wrap;-webkit-justify-content:space-between;-ms-flex-pack:justify;justify-content:space-between}.grid-item{background:#fff;border-radius:10rpx;margin-bottom:14rpx;overflow:hidden;width:48%}.grid-item .thumb{height:180rpx;width:100%}image{display:block}